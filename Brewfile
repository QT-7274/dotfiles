# Brewfile - Mac 环境配置
# 安装所有工具：brew bundle install
# 更新此文件：brew bundle dump --force（会覆盖文件，注意提前备份注释）

# --- 命令行工具 ---
brew "chezmoi"        # dotfiles 管理器，跨机器同步配置文件
brew "fd"             # 更快的 find 替代品
brew "fzf"            # 模糊搜索，用于 shell 历史和文件搜索
brew "gh"             # GitHub 官方命令行工具
brew "lazygit"        # 终端里的 git 可视化界面
brew "ripgrep"        # 更快的 grep 替代品（命令为 rg）
brew "starship"       # 跨 shell 的命令行提示符美化
brew "zoxide"         # 更智能的 cd，自动跳转到常用目录
brew "yazi"           # 终端文件管理器
brew "tmux"           # 终端多路复用器，分屏管理会话

# --- 媒体处理 ---
brew "ffmpeg"         # 视频/音频转码工具
brew "ffmpegthumbnailer" # 视频缩略图生成器（yazi 预览用）
brew "imagemagick"    # 图片处理工具
brew "poppler"        # PDF 渲染工具（yazi 预览 PDF 用）

# --- 网络 ---
brew "cloudflared"    # Cloudflare Tunnel 客户端
brew "mosh"           # 网络不稳定时的 SSH 替代方案
brew "tailscale"      # 点对点内网穿透 VPN
brew "wrk"            # HTTP 压测工具

# --- 开发 ---
brew "nvm"            # Node.js 版本管理器
brew "redis"          # 内存数据库

# --- 其他 ---
brew "rtk"            # （待补充说明）

# --- 字体 ---
cask "font-maple-mono-nf-cn" # Maple Mono，终端主字体

# --- 应用 ---
cask "jordanbaird-ice"  # 菜单栏管理工具，可隐藏/显示菜单栏图标
cask "tailscale-app"    # Tailscale 图形界面客户端

# --- VSCode 插件 ---
vscode "anthropic.claude-code"               # Claude Code AI 编程助手
vscode "ms-ceintl.vscode-language-pack-zh-hans" # VSCode 中文语言包
vscode "vibe-island.terminal-focus"          # 终端获得焦点时高亮显示
